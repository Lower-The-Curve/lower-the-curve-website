# Copy this file to `.env.local` and fill in your store's values.
# The Storefront API token is a *public* token, but we keep it server-side
# (unprefixed, not NEXT_PUBLIC_) so all Shopify calls go through Server
# Components / Server Actions and the token never ships to the browser.

# Your store's myshopify domain, e.g. lower-the-curve.myshopify.com
SHOPIFY_STORE_DOMAIN=lower-the-curve
# Storefront API access token (Settings > Apps and sales channels > Develop apps
# > your app > API credentials > Storefront API access token)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=b472e3eb4dea8e57e768f88442cd8d27

# Storefront API version. Bump this as Shopify releases new versions.
SHOPIFY_STOREFRONT_API_VERSION=2026-01
